#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE   0
#define RAISE  1
#define LOWER  2
#define NAV    3
#define BT     4
#define MOUSE  6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    // Space長押し + Enter長押し で BT層
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <RAISE LOWER>;
            then-layer = <BT>;
        };
    };

    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <4 3>;
        };

        shift {
            bindings = <&kp LEFT_SHIFT>;
            key-positions = <14 13>;
        };

        leftcnt {
            bindings = <&kp LEFT_CONTROL>;
            key-positions = <2 1>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    lt_to_layer_0: lt_to_layer_0 {
        compatible = "zmk,behavior-hold-tap";
        label = "LAYER_TAP_TO_0";
        bindings = <&mo>, <&to_layer_0>;

        #binding-cells = <2>;
        tapping-term-ms = <200>;
    };
};

/ {
    behaviors {
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&lt BT Q        &kp W     &kp E       &kp R     &kp T                                &kp Y           &kp U     &kp I     &kp O    &kp P
&kp A           &kp S     &kp D       &kp F     &kp G                                &kp H           &kp J     &kp K     &kp L    &mt RIGHT_CONTROL MINUS
&kp Z           &kp X     &kp C       &kp V     &kp B     &mkp MB2         &kp LBKT  &kp N           &kp M     &kp COMMA &kp DOT  &lt MOUSE FSLH
&mt LSHFT CAPS  &kp LGUI                        &lt RAISE SPACE  &mkp MB1 &lt LOWER RET &kp BSPC                       &kp DEL  &mt RCTRL RBKT
            >;
        };

        raise_layer {
            display-name = "Raise";
            bindings = <
&kp N1    &kp N2    &kp N3     &kp N4  &kp N5                          &kp N6  &kp N7  &kp N8  &kp N9  &kp N0
&kp LEFT  &kp UP    &kp RIGHT  &trans  &kp LANG1                       &trans  &trans  &trans  &trans  &trans
&kp LEFT  &kp DOWN  &kp RIGHT  &trans  &kp LANG2  &trans       &trans  &trans  &trans  &trans  &trans  &trans
&trans    &trans                       &trans     &trans       &trans  &trans                  &trans  &trans
            >;
        };

        lower_layer {
            display-name = "Lower";
            bindings = <
&kp LS(N1)    &kp LS(N2)  &kp LS(N3)     &kp LS(N4)  &kp LS(N5)                    &kp RS(N6)  &kp RS(N7)  &kp RS(N8)  &kp RS(N9)  &kp RS(N0)
&kp LS(LEFT)  &kp LS(UP)  &kp LS(RIGHT)  &trans      &kp LANG1                     &trans      &trans      &trans      &trans      &trans
&kp LEFT      &kp DOWN    &kp RIGHT      &trans      &kp LANG2   &trans    &trans  &trans      &trans      &trans      &trans      &trans
&trans        &trans                                 &trans      &trans    &trans  &trans                              &trans      &studio_unlock
            >;
        };

        layer_3 {
            bindings = <
&kp ESCAPE      &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &trans   &trans  &trans  &trans  &trans  &trans
&kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END  &trans  &trans  &trans  &trans  &trans
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))  &trans   &trans  &trans  &trans  &trans  &trans
&trans          &trans                  &trans          &trans                   &trans   &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_4 {
            display-name = "BT";
            bindings = <
&trans           &trans      &trans  &trans  &trans  &bt BT_SEL 0   &bt BT_SEL 1  &bt BT_SEL 2     &bt BT_SEL 3  &bt BT_SEL 4
&trans           &trans      &trans  &trans  &trans  &kp RIGHT_WIN  &kp MINUS     &kp EQUAL        &kp COMMA     &kp PERIOD
&trans           &trans      &trans  &trans  &trans  &trans         &bootloader   &kp RIGHT_SHIFT  &kp K_MUTE    &kp C_VOLUME_DOWN
&kp C_VOLUME_UP  &bt BT_CLR  &trans  &trans  &trans  &trans         &trans        &trans           &studio_unlock &bt BT_CLR_ALL
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &mkp MB4  &mkp MB5
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans
            >;
        };
    };
};
